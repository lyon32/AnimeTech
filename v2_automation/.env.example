# Copy to .env and fill. .env is gitignored — do not commit credentials.
# Values below are PLACEHOLDERS ONLY. Never put real credentials in .env.example.

# Telegram Bot API token (from @BotFather). Keep it secret.
TELEGRAM_BOT_TOKEN=<COLLER_LE_TOKEN_DE_BOTFATHER_ICI>
# Channel/croup to publish to: @channel_username or numeric id -100xxxxxxxxxx
TELEGRAM_CHANNEL_ID=-1000000000000

# Optional (only if cloud client capabilities are ever needed).
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef

# Admin Telegram user ids (comma-separated), for admin bot confirmations/notifications.
ADMIN_TELEGRAM_IDS=123456789

# Second bot (admin panel, alerts, notifications; private chats only). The first bot only publishes to the channel.
ADMIN_BOT_TOKEN=<COLLER_LE_TOKEN_DE_BOTFATHER_ICI>
