# Copy to .env and fill. .env is gitignored — do not commit credentials.
# Values below are PLACEHOLDERS ONLY. Never put real credentials in .env.example.
# Telegram Bot API token (from @BotFather). Keep it secret.
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Test channel: either @channel_username or numeric id -100xxxxxxxxxx
TELEGRAM_CHANNEL_ID=-1000000000000

TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef